@page "/staff"
@rendermode InteractiveServer
@inject LaundryAppService AppService
@implements IDisposable

<PageTitle>Staff View — SparkClean</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0">Staff View</h3>
        <small class="text-muted">Staff Member: <strong>Ayanda Dlamini</strong></small>
    </div>
    <span class="badge bg-warning text-dark fs-6">Processing Queue: @activeOrders.Count()</span>
</div>

<div class="row g-4">
    <!-- Processing Queue -->
    <div class="col-md-8">
        <h5>Incoming &amp; In-Progress Orders</h5>

        @if (!activeOrders.Any())
        {
            <div class="alert alert-light text-center">Queue is empty — no orders to process.</div>
        }
        else
        {
            @foreach (var order in activeOrders)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fw-semibold">#@order.OrderId</span>
                                <span class="badge @StatusBadge(order.Status) ms-2">@order.Status</span>
                            </div>
                            <small class="text-muted">@order.CreatedAt.ToString("HH:mm")</small>
                        </div>
                        <div class="mt-2 small">
                            <strong>Customer:</strong> @order.CustomerName &nbsp;|&nbsp;
                            <strong>Package:</strong> @order.Package &nbsp;|&nbsp;
                            <strong>Service:</strong> @order.ServiceType
                        </div>
                        @if (order.Extras != "")
                        {
                            <div class="small text-muted mt-1"><strong>Extras:</strong> @order.Extras</div>
                        }
                        <div class="mt-3 d-flex gap-2">
                            @if (order.Status == "PickedUp")
                            {
                                <button class="btn btn-sm btn-warning" @onclick="() => StartProcessing(order)">
                                    Start Processing
                                </button>
                            }
                            @if (order.Status == "InProgress")
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => MarkReady(order)">
                                    Mark as Ready
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <h5 class="mt-4">Ready / Completed</h5>
        @foreach (var order in doneOrders)
        {
            <div class="card mb-2 bg-light">
                <div class="card-body py-2 d-flex justify-content-between align-items-center">
                    <span class="small fw-semibold">#@order.OrderId — @order.CustomerName (@order.ServiceType)</span>
                    <span class="badge @StatusBadge(order.Status)">@order.Status</span>
                </div>
            </div>
        }
    </div>

    <!-- Notifications -->
    <div class="col-md-4">
        <h5>Staff Notifications</h5>
        <div class="border rounded p-2" style="max-height:420px; overflow-y:auto;">
            @foreach (var n in notifications)
            {
                <div class="border-bottom py-2 px-1">
                    <div class="small fw-semibold">@n.OrderId</div>
                    <div class="small">@n.Message</div>
                    <div class="text-muted" style="font-size:0.75rem">@n.Timestamp.ToString("HH:mm")</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    IEnumerable<OrderViewModel> activeOrders => AppService.Orders
        .Where(o => o.Status is "PickedUp" or "InProgress");

    IEnumerable<OrderViewModel> doneOrders => AppService.Orders
        .Where(o => o.Status is "ReadyForDelivery" or "Delivered");

    IEnumerable<NotificationEntry> notifications => AppService.Notifications
        .Where(n => n.Role == "Staff");

    protected override void OnInitialized()  => AppService.StateChanged += StateHasChanged;
    public void Dispose()                    => AppService.StateChanged -= StateHasChanged;

    void StartProcessing(OrderViewModel o) => DoUpdate(o, "InProgress",       "Order is now being processed.");
    void MarkReady(OrderViewModel o)       => DoUpdate(o, "ReadyForDelivery", "Order is ready for delivery collection.");

    void DoUpdate(OrderViewModel order, string newStatus, string message)
    {
        AppService.UpdateOrderStatus(order.OrderId, newStatus, message);
    }

    string StatusBadge(string status) => status switch
    {
        "PickedUp"          => "bg-info text-dark",
        "InProgress"        => "bg-warning text-dark",
        "ReadyForDelivery"  => "bg-primary",
        "Delivered"         => "bg-success",
        _                   => "bg-secondary"
    };
}
